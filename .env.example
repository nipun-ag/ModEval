# ModEval Environment Variables
# Copy this file to .env and fill in your API credentials

# OpenAI API (required for GPT-4o-mini summaries)
OPENAI_API_KEY=your_openai_key_here

# HuggingFace Inference API (required for open source models)
HF_API_KEY=your_hf_api_key_here

# Enterprise API Credentials (optional - leave empty to disable)

# Google Perspective API
# Get key at: https://perspectiveapi.com/
PERSPECTIVE_API_KEY=your_perspective_key_here

# Azure Content Safety
# Get key and endpoint at: https://portal.azure.com
AZURE_CS_KEY=your_azure_key_here
AZURE_CS_ENDPOINT=https://yourresource.cognitiveservices.azure.com

# AWS Comprehend
# Get credentials from: https://aws.amazon.com/
AWS_ACCESS_KEY_ID=your_aws_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_here
AWS_REGION=us-east-1

# Google NLP
# Get key at: https://cloud.google.com/natural-language/docs
GOOGLE_NLP_KEY=your_google_nlp_key_here
